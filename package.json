{
  "name": "feedwriter",
  "private": true,
  "scripts": {
    "test": "npm run verify:dom && npm run verify:composer && npm run verify:sw && node --test tests/**/*.test.mjs",
    "check": "node scripts/check-js.mjs",
    "build:composer": "python3 scripts/build-content-composer.py",
    "verify:composer": "python3 scripts/build-content-composer.py --check",
    "build:dom": "python3 scripts/build-content-dom.py",
    "verify:dom": "python3 scripts/build-content-dom.py --check",
    "build:sw": "python3 scripts/build-sw.py",
    "verify:sw": "python3 scripts/build-sw.py --check",
    "build": "npm run build:dom && npm run build:composer && npm run build:sw",
    "test:all": "npm run check && npm test"
  }
}
