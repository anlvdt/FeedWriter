{
  "manifest_version": 3,
  "name": "FeedWriter",
  "version": "2.8.0",
  "description": "Biến bài viết dài thành status tiếng Việt có nguồn để bạn kiểm tra và đăng. Hỗ trợ dịch tiếng Anh sang tiếng Việt.",
  "author": "Le An (anlvdt)",
  "homepage_url": "https://github.com/anlvdt/fb-post-summarizer",
  "permissions": [
    "storage",
    "alarms",
    "unlimitedStorage",
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "optional_permissions": [
    "clipboardRead"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "<all_urls>"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.groq.com/*",
    "https://api.cerebras.ai/*",
    "https://integrate.api.nvidia.com/*",
    "https://api.sambanova.ai/*",
    "https://openrouter.ai/*",
    "https://tinyurl.com/*",
    "https://is.gd/*",
    "https://v.gd/*",
    "https://da.gd/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https:; img-src 'self' data: https: blob:; style-src 'self' 'unsafe-inline'"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://web.facebook.com/*",
        "https://m.facebook.com/*"
      ],
      "js": [
        "lib/error-boundary.js",
        "utils.js",
        "lib/summary-policy.js",
        "lib/url-clean.js",
        "lib/translate-eligibility.js",
        "dom-helpers.js",
        "post-data.js",
        "status-formatter.js",
        "content-dom-runtime.js",
        "poster-facebook.js",
        "cross-poster.js",
        "content-composer-runtime.js",
        "content.js"
      ],
      "css": [
        "fonts/be-vietnam-pro.css",
        "content.css",
        "ui.css"
      ],
      "run_at": "document_end"
    },
    {
      "matches": ["https://*.threads.net/*"],
      "js": ["lib/error-boundary.js", "utils.js", "lib/summary-policy.js", "lib/url-clean.js", "lib/translate-eligibility.js", "dom-helpers.js", "post-data.js", "status-formatter.js", "content-dom-runtime.js", "poster-threads.js", "cross-poster.js", "content-composer-runtime.js", "content.js"],
      "css": ["fonts/be-vietnam-pro.css", "content.css", "ui.css"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["lib/error-boundary.js", "utils.js", "lib/summary-policy.js", "lib/url-clean.js", "lib/translate-eligibility.js", "dom-helpers.js", "post-data.js", "status-formatter.js", "content-dom-runtime.js", "poster-x.js", "cross-poster.js", "content-composer-runtime.js", "content.js"],
      "css": ["fonts/be-vietnam-pro.css", "content.css", "ui.css"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["lib/error-boundary.js", "utils.js", "lib/summary-policy.js", "lib/url-clean.js", "lib/translate-eligibility.js", "dom-helpers.js", "post-data.js", "status-formatter.js", "content-dom-runtime.js", "poster-linkedin.js", "cross-poster.js", "content-composer-runtime.js", "content.js"],
      "css": ["fonts/be-vietnam-pro.css", "content.css", "ui.css"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://www.reddit.com/*"],
      "js": ["lib/error-boundary.js", "utils.js", "lib/summary-policy.js", "lib/url-clean.js", "lib/translate-eligibility.js", "dom-helpers.js", "post-data.js", "status-formatter.js", "content-dom-runtime.js", "poster-reddit.js", "cross-poster.js", "content-composer-runtime.js", "content.js"],
      "css": ["fonts/be-vietnam-pro.css", "content.css", "ui.css"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://*/*"],
      "js": [
        "lib/error-boundary.js",
        "lib/translate-eligibility.js",
        "translate.js"
      ],
      "css": [
        "fonts/be-vietnam-pro.css",
        "translate.css"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "FeedWriter"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png",
    "256": "icons/icon256.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["fonts/*"],
      "matches": [
        "https://www.facebook.com/*",
        "https://web.facebook.com/*",
        "https://m.facebook.com/*",
        "https://*.threads.net/*",
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.linkedin.com/*",
        "https://www.reddit.com/*"
      ]
    }
  ],
  "commands": {
    "summarize-shortcut": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Tóm tắt nội dung văn bản bôi đen"
    },
    "translate-shortcut": {
      "suggested_key": {
        "default": "Ctrl+Shift+T",
        "mac": "Command+Shift+T"
      },
      "description": "Dịch văn bản bôi đen (EN → VI)"
    }
  }
}
